PORT=3000

# Banco padrão atual
DB_CLIENT=sqlite

# Sessão
# Em produção, use um segredo próprio com pelo menos 32 caracteres.
# SESSION_SECRET=defina_um_segredo_de_sessao_bem_grande

# Para usar Postgres, altere DB_CLIENT para postgres e preencha
# uma das opções abaixo.

# Opção 1: URL única
# DATABASE_URL=postgres://postgres:senha@localhost:5432/uniqstock

# Opção 2: Variáveis separadas
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=uniqstock
# PGUSER=postgres
# PGPASSWORD=sua_senha

# Modo de licença
# Desenvolvimento local:
# UNIQSTOCK_LICENSE_MODE=local
# Compatibilidade legada:
# UNIQSTOCK_FORCE_LOCAL_LICENSE=1
#
# Produção recomendada:
# UNIQSTOCK_LICENSE_MODE=supabase
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
#
# Local em produção só por exceção e com override explícito:
# UNIQSTOCK_LICENSE_MODE=local
# UNIQSTOCK_ALLOW_LOCAL_LICENSE_IN_PRODUCTION=1
# UNIQSTOCK_LICENSE_SECRET=defina_um_segredo_exclusivo_com_32_ou_mais_caracteres
#
# Modo offline
# UNIQSTOCK_OFFLINE_GRACE_DAYS=30

# Bootstrap inicial do admin
# Se não definir UNIQSTOCK_ADMIN_PASSWORD, a instalação gera uma senha forte
# por máquina e salva em bootstrap-admin.txt no runtime apenas quando o admin
# bootstrap for criado pela primeira vez.
# UNIQSTOCK_ADMIN_PASSWORD=defina_uma_senha_inicial_forte

# URL pública do UniqStock para usar em QR Codes externos
# UNIQSTOCK_PUBLIC_BASE_URL=https://app.seudominio.com.br

# Caminho opcional do SQLite de origem na migração
# SQLITE_SOURCE_PATH=D:\\uniqcode\\prz-inventario\\db\\inventario.db

# ========================================
# UniqCode Files (servidor de arquivos)
# ========================================
# UNIQCODE_FILES_PORT=3100
# UNIQCODE_FILES_API_TOKEN=defina_um_token_forte_com_32_ou_mais_caracteres
# UNIQCODE_FILES_URL=http://127.0.0.1:3100
# UNIQCODE_FILES_FERRAMENTARIA_BUCKET=ferramentaria-fotos
# UNIQCODE_FILES_FERRAMENTARIA_NF_BUCKET=ferramentaria-notas-fiscais
# UNIQCODE_FILES_RUNTIME_DIR=D:\\uniqcode\\uniqcode-files-runtime
# UNIQCODE_FILES_PUBLIC_BASE_URL=https://files.seudominio.com.br
# UNIQCODE_FILES_MAX_FILE_BYTES=26214400
#
# Banco dedicado opcional:
# UNIQCODE_FILES_DB_CLIENT=postgres
# UNIQCODE_FILES_DATABASE_URL=postgres://postgres:senha@localhost:5432/uniqcode_files
#
# Ou variaveis separadas:
# UNIQCODE_FILES_PGHOST=localhost
# UNIQCODE_FILES_PGPORT=5432
# UNIQCODE_FILES_PGDATABASE=uniqcode_files
# UNIQCODE_FILES_PGUSER=postgres
# UNIQCODE_FILES_PGPASSWORD=sua_senha
