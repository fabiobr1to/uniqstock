PORT=3000

# Banco padrao atual
DB_CLIENT=sqlite

# Para usar Postgres, altere DB_CLIENT para postgres e preencha
# uma das opcoes abaixo.

# Opcao 1: URL unica
# DATABASE_URL=postgres://postgres:senha@localhost:5432/uniqstock

# Opcao 2: Variaveis separadas
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=uniqstock
# PGUSER=postgres
# PGPASSWORD=sua_senha

# Licenciamento local e modo offline
# UNIQSTOCK_FORCE_LOCAL_LICENSE=true
# UNIQSTOCK_OFFLINE_GRACE_DAYS=30

# Bootstrap inicial do admin
# Defina antes do primeiro bootstrap para nao usar a senha padrao.
# UNIQSTOCK_ADMIN_PASSWORD=defina_uma_senha_inicial_forte

# Caminho opcional do SQLite de origem na migracao
# SQLITE_SOURCE_PATH=D:\\uniqcode\\prz-inventario\\db\\inventario.db
